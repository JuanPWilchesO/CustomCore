<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.juanp.custommobs</groupId>
    <artifactId>CustomMobs</artifactId>
    <version>1.0.7-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>CustomMobs</name>
    <description>Mobs custom definidos por YAML, invocables por crafteo, con vinculo a Teams.</description>

    <licenses>
        <license>
            <name>GNU General Public License v3.0</name>
            <url>https://www.gnu.org/licenses/gpl-3.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <modules>
        <module>API</module>
        <module>Core</module>
    </modules>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <paper.version>26.3.build.49-alpha</paper.version>
        <teams.version>1.0.2</teams.version>
        <libsdisguises.version>26.9.24</libsdisguises.version>
        <!-- BetterModel no publica su API en un repositorio Maven publico: el jar vive en
             libs/ y se instala con scripts/install-libs.sh. La clase de la API es la misma
             que trae el plugin en tiempo de ejecucion. -->
        <bettermodel.version>3.5.1</bettermodel.version>
        <kotlin.version>2.4.21</kotlin.version>
        <packetevents.version>2.14.0</packetevents.version>
        <luckperms.version>5.5</luckperms.version>
        <worldguard.version>7.0.19</worldguard.version>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <repository>
            <id>enginehub</id>
            <url>https://maven.enginehub.org/repo/</url>
        </repository>
    </repositories>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>3.6.2</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
